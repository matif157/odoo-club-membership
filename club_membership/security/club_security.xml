<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_club" model="ir.module.category">
        <field name="name">Club Membership</field>
        <field name="description">Access to memberships and membership plans.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_club_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_club"/>
        <field name="comment">Can create and follow memberships and invoices.</field>
    </record>

    <record id="group_club_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_club"/>
        <field name="implied_ids" eval="[(4, ref('group_club_user'))]"/>
        <field name="comment">Full access, including plans and deletion.</field>
    </record>

</odoo>
