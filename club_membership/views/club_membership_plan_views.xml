<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_membership_plan_list" model="ir.ui.view">
        <field name="name">club.membership.plan.list</field>
        <field name="model">club.membership.plan</field>
        <field name="arch" type="xml">
            <list string="Membership Plans" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="billing_period"/>
                <field name="period_months" optional="hide"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="membership_count" string="Members"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_club_membership_plan_form" model="ir.ui.view">
        <field name="name">club.membership.plan.form</field>
        <field name="model">club.membership.plan</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="billing_period"/>
                            <field name="period_months"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_club_membership_plan_search" model="ir.ui.view">
        <field name="name">club.membership.plan.search</field>
        <field name="model">club.membership.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_club_membership_plan" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">club.membership.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
